# e-Madrasah: template konfigurasi PRODUKSI.
# Salin menjadi .env di server, isi nilai yang kosong, lalu: php artisan key:generate --force
# Jangan pernah meng-commit .env. Panduan lengkap: docs/DEPLOYMENT.md

APP_NAME="e-Madrasah"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://madrasah-anda.sch.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

# Di belakang Nginx/Cloudflare/load balancer: IP proxy dipisah koma, atau * bila tidak bisa dipastikan.
# Tanpa ini, https dan IP asli pengunjung tidak terbaca (pembatas login jadi tidak akurat).
TRUSTED_PROXIES=

# Log harian, simpan 14 hari, hanya peringatan ke atas.
LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Database produksi (disarankan MySQL/MariaDB). Buat user khusus dengan hak hanya pada database ini.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=emadrasah
DB_USERNAME=emadrasah
DB_PASSWORD=

# Session aman: cookie hanya lewat https, terenkripsi, kedaluwarsa 2 jam tanpa aktivitas.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

BCRYPT_ROUNDS=12
FILESYSTEM_DISK=local
CACHE_STORE=database
QUEUE_CONNECTION=database

# Email. Saat ini aplikasi belum mengirim email apa pun (belum ada fitur lupa kata sandi/notifikasi),
# jadi bagian ini boleh dibiarkan. Isi bila fitur tersebut ditambahkan.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@madrasah-anda.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# Nilai awal identitas madrasah. Setelah masuk sebagai admin, ubah dari menu Pengaturan.
MADRASAH_SHORT_NAME="Nama Singkat"
MADRASAH_NAME="Nama Madrasah"
MADRASAH_FULL_NAME="Nama Resmi Madrasah"
